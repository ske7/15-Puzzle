# Overlaid on top of .env only for `vite build --mode test` (the on-demand Playwright E2E
# build - see playwright.config.ts). VITE_BASE_URL feeds src/const.ts's baseUrl, which the
# app uses for self-referential links/redirects (e.g. checkGameLink's location.href = baseUrl
# on a missing game record) - it needs to point at the real preview server E2E actually runs
# against (port 4173), not the dev-server port baked into the shared .env.
VITE_BASE_URL=http://localhost:4173
